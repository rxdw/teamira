# Copy this file to .env before running docker compose up

DATABASE_URL=postgresql+psycopg2://seenly:seenly@db:5432/seenly
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# App-level SIMKL credentials (one app key, not per-user) — https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=

# Games — https://api-docs.igdb.com (runs on Twitch's dev platform; free
# for non-commercial use, see api-docs.igdb.com and partner@igdb.com for
# commercial terms). Register an app at dev.twitch.tv/console/apps to get
# these. Empty means games just don't show up in search/collections; nothing errors.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Books — https://developers.google.com/books (Google Cloud Console:
# enable "Books API", then Credentials -> Create Credentials -> API key).
# Optional — Books works unauthenticated too, just on a lower shared quota.
GOOGLE_BOOKS_API_KEY=

# Kinopoisk ratings + reviews for Russian-language users (poiskkino.dev —
# an unofficial mirror, not a Yandex API). Get a token from the
# @poiskkinodev_bot Telegram bot. Free tier: 200 requests/day. Optional —
# empty just hides the Kinopoisk numbers and reviews. Note: the API has
# been unreachable from some Russian networks without a VPN, so test from
# the machine/server that actually runs the backend (and from inside the
# api container for local Docker).
POISKKINO_API_KEY=
# Requests this process allows itself per UTC day (keep under your tier).
POISKKINO_DAILY_BUDGET=180

# Hardcover — the community rating on a book's title screen (aggregate only;
# Hardcover's API policy doesn't allow showing user reviews in a public
# product). Create a personal access token at hardcover.app/account/api and
# give it only the read scopes it needs (a 403 in the backend log names a
# missing scope). Free tier: 60 requests/minute, 5,000/day. Optional — empty
# means books just show no Hardcover rating.
HARDCOVER_API_TOKEN=
HARDCOVER_DAILY_BUDGET=4000

# "Your sources" (Settings -> your sources) — link-based import of public
# YouTube playlists/channels/videos. Google Cloud Console: enable "YouTube
# Data API v3", then Credentials -> Create Credentials -> API key.
YOUTUBE_API_KEY=

# Twitch half of "your sources" — same dev.twitch.tv/console/apps app as
# IGDB_CLIENT_ID above works fine here too (leave these two blank to just
# reuse it); a separate app is only needed if you want separate quotas.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Referral links — see REFERRAL_AND_PROFILE_SETUP.md for what each of
# these unlocks and how to get the real values. All optional: the
# referral link works with none of these set, just as a bare invite
# code with no clickable URL and store fallbacks that go nowhere.
PUBLIC_WEB_BASE_URL=
PLAY_STORE_PACKAGE=
IOS_APP_STORE_ID=
ANDROID_CERT_SHA256_FINGERPRINTS=
IOS_APP_ID=

# --- Auth lifetimes -------------------------------------------------------
# Access tokens are short now; POST /auth/refresh keeps sessions alive.
JWT_EXPIRE_MINUTES=30
REFRESH_TOKEN_DAYS=60
MAX_SESSIONS_PER_USER=10

# --- Email (account recovery) ---------------------------------------------
# "console" logs the message instead of sending it — fine locally, a leak in
# production. Switch to "smtp" and fill in the host before launch.
EMAIL_BACKEND=console
EMAIL_FROM=tane <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFY_TTL_MINUTES=1440

# --- Account deletion -----------------------------------------------------
ACCOUNT_PURGE_AFTER_DAYS=30
# Leave true for a single container; set false and run
# scripts/purge_deleted_accounts.py from cron for anything serious.
PURGE_ON_STARTUP=true

# --- Moderation -----------------------------------------------------------
REPORT_SLA_HOURS=24
EULA_VERSION=2026-09-01
# Published contact address for content complaints — App Store review
# expects one. Empty falls back to the in-app report flow.
MODERATION_CONTACT_EMAIL=
# One term per line, '#' comments allowed. Empty means the structural
# checks in app/content_filter.py run alone.
CONTENT_BLOCKLIST_PATH=

# Required so reset/verification links in emails point somewhere real.
PUBLIC_WEB_BASE_URL=https://yourdomain.com

# Product analytics — see docs/analytics.md
ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=400

# Grafana dashboards (optional, docker compose --profile analytics up -d grafana)
# — see docs/analytics.md, section "Grafana". Read by docker compose from the .env
# next to docker-compose.yml, not by the API.
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me-too
