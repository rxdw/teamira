# Copy this file to .env before running docker compose up

DATABASE_URL=postgresql+psycopg2://seenly:seenly@db:5432/seenly
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# App-level SIMKL credentials (one app key, not per-user) — https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=

# Games — https://api-docs.igdb.com (runs on Twitch's dev platform; free
# for non-commercial use, see api-docs.igdb.com and partner@igdb.com for
# commercial terms). Register an app at dev.twitch.tv/console/apps to get
# these. Empty means games just don't show up in search/collections; nothing errors.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Books — https://developers.google.com/books (Google Cloud Console:
# enable "Books API", then Credentials -> Create Credentials -> API key).
# Optional — Books works unauthenticated too, just on a lower shared quota.
GOOGLE_BOOKS_API_KEY=

# "Your sources" (Settings -> your sources) — link-based import of public
# YouTube playlists/channels/videos. Google Cloud Console: enable "YouTube
# Data API v3", then Credentials -> Create Credentials -> API key.
YOUTUBE_API_KEY=

# Twitch half of "your sources" — same dev.twitch.tv/console/apps app as
# IGDB_CLIENT_ID above works fine here too (leave these two blank to just
# reuse it); a separate app is only needed if you want separate quotas.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Referral links — see REFERRAL_AND_PROFILE_SETUP.md for what each of
# these unlocks and how to get the real values. All optional: the
# referral link works with none of these set, just as a bare invite
# code with no clickable URL and store fallbacks that go nowhere.
PUBLIC_WEB_BASE_URL=
PLAY_STORE_PACKAGE=
IOS_APP_STORE_ID=
ANDROID_CERT_SHA256_FINGERPRINTS=
IOS_APP_ID=
