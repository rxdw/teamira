# Copy this file to .env before running docker compose up

# "development" (default) keeps the zero-config local-dev experience
# below completely untouched. Set to "production" only on a real
# deployment — it makes app/main.py's on_startup refuse to boot instead
# of just logging critical if JWT_SECRET is still "change-me" or
# EMAIL_BACKEND isn't "smtp". See docker-compose.prod.yml.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://seenly:seenly@db:5432/seenly
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Which origins may fetch this API's browser-facing pages (mainly
# linking.py's deep-link landing pages) — irrelevant to the mobile app
# itself, since native HTTP calls aren't subject to CORS at all. Comma-
# separated, e.g. "https://teamira.app,https://www.teamira.app". Leave
# as "*" for local development; set this to the real site(s) before
# anything here is reachable by the public.
CORS_ALLOW_ORIGINS=*

# Referral + shared-title deep links (app/routers/linking.py — see that
# module's own docstring for the full design). Every one of these is
# empty-safe: the /i/{code} and /t landing pages, and the two
# /.well-known files below them, all work with these left blank, just
# without the "OS opens the app directly" upgrade each one unlocks.
#
# The custom scheme the app already registers (mobile/ios and
# mobile/android) — only worth changing if the app itself changes it.
APP_CUSTOM_SCHEME=seenly
# The domain that hosts this API's /i/{code} and /t pages, e.g.
# "https://teamira.app" — GET /friends/invite's share_text has nowhere
# to put a link without this (see routers/friends.py::get_invite), and
# it's the domain that has to carry both /.well-known files below to
# whichever domain you actually deploy this backend on.
PUBLIC_WEB_BASE_URL=
# Android App Links (assetlinks.json) — real once both are filled in:
# the Play Console listing's package name, and the release keystore's
# SHA-256 cert fingerprint(s) (`keytool -list -v -keystore
# your.keystore`, comma-separated if you sign with more than one during
# development). Empty just means Android falls back to the /i/{code}
# landing page instead of opening the app directly — not a broken state.
PLAY_STORE_PACKAGE=
ANDROID_CERT_SHA256_FINGERPRINTS=
# iOS Universal Links (apple-app-site-association) — real once set to
# "TEAMID.bundle.id": the Apple Team ID from Apple Developer >
# Membership, plus this app's iOS bundle id (mobile/ios/Runner.xcodeproj,
# currently com.example.seenly). Filling this in is only half of it —
# mobile/ios/Runner/Runner.entitlements also needs its
# associated-domains entry changed from the "yourdomain.com" placeholder
# to this same PUBLIC_WEB_BASE_URL host, or iOS never asks this API for
# apple-app-site-association in the first place. Empty here just means
# every iOS tap falls back to the /i/{code} or /t page's own redirect,
# same "not broken, just unconfigured" story as the Android pair above.
IOS_APP_ID=
# Numeric App Store id, once this app is actually published — lets the
# /i/{code} and /t pages' "don't have the app yet" fallback deep-link
# straight into the App Store listing instead of a bare download page.
IOS_APP_STORE_ID=

# Games — https://api-docs.igdb.com (runs on Twitch's dev platform; free
# for non-commercial use, see api-docs.igdb.com and partner@igdb.com for
# commercial terms). Register an app at dev.twitch.tv/console/apps to get
# these. Empty means games just don't show up in search/collections; nothing errors.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Books — Open Library (openlibrary.org). No key needed, nothing to set
# here; see app/adapters/open_library.py to set a contact email/URL in
# ADAPTER_CONTACT for the higher (3x) unauthenticated rate limit.

# "Where to watch" (Netflix/Disney+/etc availability) — free key from
# https://www.themoviedb.org/settings/api. This gets you availability data
# only, not affiliate revenue by itself — see app/routers/watch.py's
# module docstring for the actual monetization path (JustWatch partner
# API, Amazon Associates, Impact/CJ/Rakuten). Empty means the "where to
# watch" section just doesn't show up; nothing errors.
TMDB_API_KEY=

# Second written-reviews source (see app/adapters/trakt.py) — TMDB's own
# /reviews endpoint is often nearly empty; Trakt's /comments has a bigger,
# more active user base for the same titles. Free app-level Client ID from
# https://app.trakt.tv/settings/apps/api (click the + in the top right;
# redirect URI can be urn:ietf:wg:oauth:2.0:oob — no OAuth flow needed for
# these read-only calls, just the Client ID). Empty means reviews just
# fall back to TMDB-only, same as before.
TRAKT_CLIENT_ID=

# Подборки Teamira — shared secret for the /teamira/admin/* endpoints
# (create/edit hand-curated shelves; see app/routers/teamira.py). Pick any
# long random string and send it back as the X-Teamira-Admin-Key header.
# Empty means those endpoints always reject.
TEAMIRA_ADMIN_KEY=

# Only needed if you proxy poster/backdrop images through this server for
# clients that can't reach image.tmdb.org directly (see
# app/routers/image_proxy.py's module docstring) — set PUBLIC_API_BASE_URL
# to this server's own public URL to turn that on. IMAGE_PROXY_SECRET
# signs those proxy URLs so /media/image-proxy can stay open to the app's
# image widget (no login token) without becoming a free CDN proxy for
# anyone else; leave it empty to fall back to JWT_SECRET, but set a
# distinct value in production so rotating one doesn't also invalidate
# every login session.
PUBLIC_API_BASE_URL=
IMAGE_PROXY_SECRET=

# Cap, in bytes, on app/routers/image_proxy.py's on-disk image cache —
# see config.py's own docstring for why this exists (that cache never
# expires an entry on its own). Empty/unset falls back to 2 GiB.
IMAGE_PROXY_CACHE_MAX_BYTES=

# Comma-separated IPs/CIDRs of reverse proxies this backend should trust
# to set X-Forwarded-For truthfully (see app/rate_limit.py::client_key).
# Leave empty (the default) until there's an actual reverse proxy or TLS
# terminator in front of this app — today's docker-compose.yml exposes
# the api container's port directly, so request.client.host already is
# the real caller and there's nothing to trust yet.
TRUSTED_PROXY_IPS=

# Error tracking (app/main.py) — leave empty to disable entirely.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Fraction (0.0-1.0) of requests also traced for performance, separate
# from error reporting (which happens regardless of this value).
SENTRY_TRACES_SAMPLE_RATE=0.0

# "text" (default) leaves logging exactly as uvicorn's own console
# output has always looked. Set to "json" once logs are actually going
# somewhere that parses structure out of them (CloudWatch, Datadog, an
# ELK stack) rather than a terminal — see app/logging_config.py.
LOG_FORMAT=text

# Product analytics (app/routers/analytics.py, docs/analytics.md).
# The mobile app batches usage events to POST /analytics/events; they land
# in the analytics_events table. false makes the endpoint accept-and-discard
# (it still answers 202, so installed apps don't start retrying).
ANALYTICS_ENABLED=true
# Events older than this many days are deleted by the housekeeping sweep
# (startup when PURGE_ON_STARTUP=true, or scripts/purge_deleted_accounts.py).
# 0 keeps everything forever.
ANALYTICS_RETENTION_DAYS=400

# --- Push notifications (app/push.py; setup: docs/push_notifications_setup.md) ---
# The full JSON of a Firebase service-account key (what the Firebase console
# downloads as "generate new private key") on ONE line — the contents, not a
# file path. Empty (the default) turns push off entirely: nothing is sent and
# firebase-admin is never imported.
FIREBASE_CREDENTIALS_JSON=
