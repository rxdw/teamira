# Copy this file to .env before running docker compose up

DATABASE_URL=postgresql+psycopg2://seenly:seenly@db:5432/seenly
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Games — https://api-docs.igdb.com (runs on Twitch's dev platform; free
# for non-commercial use, see api-docs.igdb.com and partner@igdb.com for
# commercial terms). Register an app at dev.twitch.tv/console/apps to get
# these. Empty means games just don't show up in search/collections; nothing errors.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Books — Open Library (openlibrary.org). No key needed, nothing to set
# here; see app/adapters/open_library.py to set a contact email/URL in
# ADAPTER_CONTACT for the higher (3x) unauthenticated rate limit.

# "Where to watch" (Netflix/Disney+/etc availability) — free key from
# https://www.themoviedb.org/settings/api. This gets you availability data
# only, not affiliate revenue by itself — see app/routers/watch.py's
# module docstring for the actual monetization path (JustWatch partner
# API, Amazon Associates, Impact/CJ/Rakuten). Empty means the "where to
# watch" section just doesn't show up; nothing errors.
TMDB_API_KEY=

# Second written-reviews source (see app/adapters/trakt.py) — TMDB's own
# /reviews endpoint is often nearly empty; Trakt's /comments has a bigger,
# more active user base for the same titles. Free app-level Client ID from
# https://app.trakt.tv/settings/apps/api (click the + in the top right;
# redirect URI can be urn:ietf:wg:oauth:2.0:oob — no OAuth flow needed for
# these read-only calls, just the Client ID). Empty means reviews just
# fall back to TMDB-only, same as before.
TRAKT_CLIENT_ID=

# Подборки Teamira — shared secret for the /teamira/admin/* endpoints
# (create/edit hand-curated shelves; see app/routers/teamira.py). Pick any
# long random string and send it back as the X-Teamira-Admin-Key header.
# Empty means those endpoints always reject.
TEAMIRA_ADMIN_KEY=
