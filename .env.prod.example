# Copy to ".env" in this same directory (next to docker-compose.prod.yml)
# before running: docker compose -f docker-compose.prod.yml up -d --build
#
# This is a SEPARATE file from backend/.env — docker compose reads a
# ".env" here automatically to fill in the ${...} placeholders inside
# docker-compose.prod.yml itself (the db service's credentials). It has
# nothing to do with the app's own settings (JWT_SECRET, TMDB/IGDB keys,
# SMTP_*, ...) — those still live in backend/.env exactly as they do
# today; this file only covers the Postgres container's own credentials.
#
# Pick real values — docker-compose.prod.yml refuses to start at all
# (not even build) if any of these three are left unset.

POSTGRES_USER=seenly
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=seenly
