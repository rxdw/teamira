<?xml version="1.0" encoding="utf-8"?>
<!-- One layout for all of HomeWidgetService's states (countdown/pick/
     streak/empty/locked) — SeenlyWidgetProvider.kt toggles which of
     widget_poster / widget_number is visible and fills in the text;
     RemoteViews has no if/else in XML, so "one layout, hide what
     doesn't apply" is the standard pattern rather than five layouts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/seenly_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="tanè"
        android:textColor="#A8967F"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- "pick" state: today's franchise-shelf poster, rounded at the
             bitmap level in Kotlin (RemoteViews ImageViews can't clip to
             an outline on their own below API 31). -->
        <ImageView
            android:id="@+id/widget_poster"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <!-- "countdown"/"streak" state: the one big number those two
             share a slot for (days-until, or the streak count itself). -->
        <TextView
            android:id="@+id/widget_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textColor="#7D5A6B"
            android:textStyle="bold"
            android:textSize="30sp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#4A3F38"
                android:textStyle="bold"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#8A7A68"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"/>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
